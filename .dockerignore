# Build context: source only. Model artifacts under ml/artifacts/ are deliberately NOT excluded —
# the API and worker load them from the image (see docs/DEPLOY.md).
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
node_modules
frontend/node_modules
frontend/dist
data/
reports/tmp
tests/
.env
*.log
htn_challenge_logs_*.txt
docker-compose.yml
