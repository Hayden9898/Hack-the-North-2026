# Copy to .env and adjust. Nothing here is a secret; real secrets never get committed.

# Local TimescaleDB started by `docker compose up -d db`. For Tiger Cloud use the provided
# postgres://...?sslmode=require URL (TLS is required for any non-loopback host).
DATABASE_URL=postgresql://logorder:logorder@localhost:5433/logorder
# Used only by integration tests (a separate database on the same server).
TEST_DATABASE_URL=postgresql://logorder:logorder@localhost:5433/logorder_test

# Local import CLI input. Never hardcoded into application code.
DATASET_PATH=./htn_challenge_logs_2026.txt
# Only locally generated, versioned model artifacts are loaded from here.
MODEL_DIR=./ml/artifacts
# Trusted base URL used to build links inside alerts.
APP_BASE_URL=http://127.0.0.1:5173
# Bind address for the API. Loopback by default; anything else requires auth + TLS in front.
API_HOST=127.0.0.1
API_PORT=8000

# Shared-deployment secrets (leave empty for the local loopback demo).
APP_AUTH_SECRET=
INGEST_TOKEN=

# Sentry Tracing + Logs. Disabled (and reported as disabled) when the DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# One LLM provider. Deterministic-only explanation mode when the key is absent.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=

# Slack delivery. preview = messages rendered and stored, nothing leaves the application.
# live = deliver via the webhook below to the intended test destination.
SLACK_MODE=preview
SLACK_WEBHOOK_URL=
# Hard cap on messages actually sent per run when live delivery is enabled.
MAX_RUN_NOTIFICATION_COUNT=20
