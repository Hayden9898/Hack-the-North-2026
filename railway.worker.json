{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m scripts.wait_for_db && python -m scripts.serve_worker",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "sleepApplication": false
  }
}
