# Project-local only. This machine's ~/.npmrc points npm at Wealthsimple's Nexus proxy,
# which 403s every public tarball, and Zscaler blocks registry.npmjs.org outright.
# npmmirror is a read-only public mirror of registry.npmjs.org that Zscaler does allow.
registry=https://registry.npmmirror.com/
always-auth=false
# esbuild/rolldown need their postinstall to link the platform binary.
ignore-scripts=false
min-release-age=0
