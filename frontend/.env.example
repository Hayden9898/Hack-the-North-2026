# Development/preview server proxy target. Never exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional PUBLIC project DSN. Never put a Sentry auth token in a VITE_ variable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
